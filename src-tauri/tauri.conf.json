{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinZal",
  "version": "1.7.11",
  "identifier": "app.winzal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "notch",
        "create": false,
        "title": "WinZal",
        "width": 1260,
        "height": 560,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://raw.githubusercontent.com https://api.open-meteo.com https://geocoding-api.open-meteo.com https://get.geojs.io https://ipwho.is; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Bipin Rizal",
    "copyright": "Copyright (c) 2026 Bipin Rizal",
    "shortDescription": "A Windows dynamic island.",
    "longDescription": "WinZal is a native Windows dynamic island with media, lyrics, system stats, clipboard, timer, vault and more.",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMEVEMkM5NzBEODhBNTIKUldSU2l0aHd5ZElPb21KQkgyMlhnRUdMUG96V2k5RkRDaDlndzZVNTg5d2hINllVb1dXT2pxRFcK",
      "endpoints": [
        "https://github.com/Bipin223/WinZal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
